set dofileName outputs/fifo_scan_testproc.dofile
set designFile /home/syed/musharaf/fifo/front/dft/outputs/fifo_scan.v
set topName {sync_fifo}
set libName "libs/slow_vdd1v0.mdt"


proc verify_all_scan_modes {} {
   set modeList [list int_mode]
   foreach mode $modeList {
      set_system_mode setup
      reset_design
      tessent_scan_setup $mode
      set_edt_options off
      add_black_box -auto
      set_system_mode analysis
      report_scan_cells
   }
}


set_context patterns -scan
delete_design
read_cell_library $libName
read_verilog $designFile
set_current_design $topName
dofile $dofileName

verify_all_scan_modes
