ASCII_PATTERN_FILE_VERSION = 3;


EDT_CONFIGURATION =

  ip_version        = 8;
  channels          = 3;
  decompressor_size = 16;
  shift_cycles      = 57;
  scan_chains       = 3;

end;

SETUP = 

    declare input bus "PI" = "/clk_i", "/rst_i", "/wr_en_i", "/rd_en_i", "/wr_data_i[7]",
         "/wr_data_i[6]", "/wr_data_i[5]", "/wr_data_i[4]", "/wr_data_i[3]", "/wr_data_i[2]", "/wr_data_i[1]",
         "/wr_data_i[0]", "/scan_en", "/edt_clock", "/edt_update", "/edt_bypass", "/edt_channels_in1",
         "/edt_channels_in2", "/edt_channels_in3";

    declare output bus "PO" = "/rd_data_o[7]", "/rd_data_o[6]", "/rd_data_o[5]", "/rd_data_o[4]", "/rd_data_o[3]",
         "/rd_data_o[2]", "/rd_data_o[1]", "/rd_data_o[0]", "/full_o", "/empty_o", "/error_o",
         "/edt_channels_out1", "/edt_channels_out2", "/edt_channels_out3";

    clock "/clk_i" =
        off_state   = 0;
        pulse_width = 1;
    end;

    clock "/edt_clock" =
        off_state   = 0;
        pulse_width = 1;
    end;

    procedure test_setup "test_setup" =
        force "/edt_clock" 0 0;
        period 40;
    end;
    scan_group "grp1" =
        scan_chain "chain0" =
            scan_in = "/sync_fifo_i/ts_si[0]";
            scan_out = "/sync_fifo_i/ts_so[0]";
            length = 49;
        end;
        scan_chain "chain1" =
            scan_in = "/sync_fifo_i/ts_si[1]";
            scan_out = "/sync_fifo_i/ts_so[1]";
            length = 49;
        end;
        scan_chain "chain2" =
            scan_in = "/sync_fifo_i/ts_si[2]";
            scan_out = "/sync_fifo_i/ts_so[2]";
            length = 49;
        end;
        procedure shift "grp1_load_shift" =
            force_sci "chain0" 0;
            force_sci "chain1" 0;
            force_sci "chain2" 0;
            force "/edt_update" 0 0;
            force "/clk_i" 1 20;
            force "/edt_clock" 1 20;
            force "/clk_i" 0 30;
            force "/edt_clock" 0 30;
            period 40;
        end;
        procedure shift "grp1_unload_shift" =
            force "/edt_update" 0 0;
            measure_sco "chain0" 10;
            measure_sco "chain1" 10;
            measure_sco "chain2" 10;
            force "/clk_i" 1 20;
            force "/edt_clock" 1 20;
            force "/clk_i" 0 30;
            force "/edt_clock" 0 30;
            period 40;
        end;
        procedure load "grp1_load" =
            force "/clk_i" 0 0;
            force "/edt_bypass" 0 0;
            force "/edt_clock" 0 0;
            force "/edt_update" 1 0;
            force "/scan_en" 1 0;
            force "/edt_clock" 1 20;
            force "/edt_clock" 0 30;
            apply "grp1_load_shift" 49 40;
        end;
        procedure unload "grp1_unload" =
            force "/clk_i" 0 0;
            force "/edt_bypass" 0 0;
            force "/edt_clock" 0 0;
            force "/edt_update" 1 0;
            force "/scan_en" 1 0;
            force "/edt_clock" 1 20;
            force "/edt_clock" 0 30;
            apply "grp1_unload_shift" 49 40;
        end;
    end;

end;

