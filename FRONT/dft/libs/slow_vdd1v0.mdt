library_format_version = 9;

array_delimiter = "[]";

model DFF_UDP
  (Q, S, R, CK,
   D)
(
  model_source = verilog_udp;
  simulation_function = dff;

  input (S) ( active_high_set; )  // ActiveHI Asynch. Set.
  input (R) ( active_high_reset; )  // ActiveHI Asynch. Reset.
  input (CK) ( posedge_clock; )  // Posedge Triggered Clock.
  input (D) ( data_in; )
  output (Q) ( data_out; )
  (
    primitive = _inv mlc_reset_not_gate (R, mlc_reset_not_net);
    primitive = _and mlc_set_and_gate (mlc_reset_not_net, S, mlc_set_and_net);
    primitive = _dff mlc_dff (mlc_set_and_net, R, CK, D, Q,  );
  )
) // end model DFF_UDP



model DLAT_UDP
  (Q, S, R, CK,
   D)
(
  model_source = verilog_udp;
  simulation_function = latch;

  input (S) ( active_high_set; )  // ActiveHI Asynch. Set.
  input (R) ( active_high_reset; )  // ActiveHI Asynch. Reset.
  input (CK) ( active_high_clock; )  // ActiveHI Level Sensitive Clock.
  input (D) ( data_in; )
  output (Q) ( data_out; )
  (
    primitive = _inv mlc_reset_not_gate (R, mlc_reset_not_net);
    primitive = _and mlc_set_and_gate (mlc_reset_not_net, S, mlc_set_and_net);
    primitive = _dlat mlc_latch (mlc_set_and_net, R, CK, D, Q,  );
  )
) // end model DLAT_UDP




